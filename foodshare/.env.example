# ============================================================
# FoodShare - Environment Variables Example
# ============================================================
# Copy file này thành .env và điền giá trị thực tế.
# File .env KHÔNG được commit lên Git.
# ============================================================

# --- Server ---
SERVER_PORT=8080

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/foodsharedb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password

# --- JPA / Hibernate ---
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# --- Flyway ---
FLYWAY_ENABLED=true

# --- JWT ---
JWT_SECRET=your_base64_encoded_256bit_secret_key
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=2592000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Cookie ---
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
OPENAPI_ENABLED=true

# --- Frontend CORS ---
APP_FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://localhost:4173
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# --- Default Admin Account ---
DEFAULT_ADMIN_PHONE=0987654321
DEFAULT_ADMIN_EMAIL=admin@foodshare.com
DEFAULT_ADMIN_PASSWORD=your_admin_password
DEFAULT_ADMIN_FULLNAME=FoodShare Administrator

# --- Cloudinary (Image Upload) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Geoapify (Geocoding) ---
GEOAPIFY_API_KEY=your_geoapify_api_key
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_TIMEOUT_MS=5000
GEOCODING_RATE_LIMIT_PER_MINUTE=30

# --- Infobip (4-digit Phone OTP) ---
INFOBIP_BASE_URL=https://your-subdomain.api.infobip.com
INFOBIP_API_KEY=your_rotated_infobip_api_key
INFOBIP_APPLICATION_ID=your_2fa_application_id
INFOBIP_MESSAGE_ID=your_2fa_message_template_id
INFOBIP_SENDER=ServiceSMS
INFOBIP_TIMEOUT_MS=5000

# --- Firebase (FCM Push Notification) ---
FIREBASE_CREDENTIALS_PATH=classpath:foodshare-firebase-adminsdk.json

# --- Email (SMTP): enable only after setting real credentials ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLED=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
MAIL_TEST_CONNECTION=false

# --- Actuator ---
HEALTH_SHOW_DETAILS=never
DB_SLOW_QUERY_THRESHOLD_MS=250

# --- Upload Limits ---
MAX_DOCUMENTS=5
MAX_DOCUMENT_SIZE_MB=10
